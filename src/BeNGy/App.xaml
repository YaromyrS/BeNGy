<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
			 xmlns:local="clr-namespace:BeNGy"
			 xmlns:helpers="clr-namespace:BeNGy.Helpers"
			 x:Class="BeNGy.App">
	<Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="Resources/Styles/Colors.xaml" />
				<ResourceDictionary Source="Resources/Styles/Styles.xaml" />
			</ResourceDictionary.MergedDictionaries>

			<!-- Validation converters (Story 3.2 / 3.3) -->
			<helpers:ValidationStatusConverter x:Key="ValidationStatusConverter" />
			<helpers:ValidationColorConverter  x:Key="ValidationColorConverter" />
			<helpers:StringNotEmptyConverter   x:Key="StringNotEmptyConverter" />
			<helpers:CopySuccessColorConverter x:Key="CopySuccessColorConverter" />
			<helpers:InvertedBoolConverter     x:Key="InvertedBoolConverter" />
		</ResourceDictionary>
	</Application.Resources>
</Application>
