<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BeNGy.ViewModels"
             x:Class="BeNGy.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="Settings">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Done" AutomationId="DoneButton" Clicked="OnDoneClicked" SemanticProperties.Description="Done" />
    </ContentPage.ToolbarItems>

    <Grid>
        <!-- Overlay to prevent interaction during capture (M1 Fix) -->
        <BoxView IsVisible="{Binding IsCapturingHotkey}"
                 BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray900}}"
                 Opacity="0.5"
                 InputTransparent="False"
                 ZIndex="10">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ChangeHotkeyCommand}" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <ScrollView Padding="20">
            <VerticalStackLayout Spacing="8">

                <!-- Other sections disabled during capture (M1 Fix) -->
                <VerticalStackLayout Spacing="8" IsEnabled="{Binding IsCapturingHotkey, Converter={StaticResource InvertedBoolConverter}}">
                    <!-- ── Branch Generation ────────────────────────────── -->
                    <Label Text="Branch Generation"
                           FontSize="18"
                           FontAttributes="Bold"
                           Margin="0,0,0,8"/>

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto">
                        <Label Text="Default Prefix"
                               VerticalOptions="Center"/>
                        <Picker Grid.Column="1"
                                AutomationId="DefaultPrefixPicker"
                                SemanticProperties.Description="Default prefix"
                                ItemsSource="{Binding AvailablePrefixes}"
                                SelectedItem="{Binding DefaultPrefix}"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto" Margin="0,12,0,0">
                        <Label Text="Title Format"
                               VerticalOptions="Center"/>
                        <Picker Grid.Column="1"
                                AutomationId="TitleFormatPicker"
                                SemanticProperties.Description="Title format"
                                ItemsSource="{Binding AvailableTitleFormats}"
                                SelectedItem="{Binding SelectedTitleFormat}"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto" Margin="0,12,0,0">
                        <Label Text="Prefix/Ticket Separator"
                               VerticalOptions="Center"/>
                        <Picker Grid.Column="1"
                                AutomationId="PrefixSeparatorPicker"
                                SemanticProperties.Description="Prefix ticket separator"
                                ItemsSource="{Binding AvailableSeparators}"
                                SelectedItem="{Binding PrefixTicketSeparator}"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto" Margin="0,12,0,0">
                        <Label Text="Ticket/Title Separator"
                               VerticalOptions="Center"/>
                        <Picker Grid.Column="1"
                                AutomationId="TicketSeparatorPicker"
                                SemanticProperties.Description="Ticket title separator"
                                ItemsSource="{Binding AvailableSeparators}"
                                SelectedItem="{Binding TicketTitleSeparator}"/>
                    </Grid>
                </VerticalStackLayout>

                <!-- ── Global Hotkey (Always enabled for Cancel/Capture) ── -->
                <Label Text="Global Hotkey"
                       FontSize="18"
                       FontAttributes="Bold"
                       Margin="0,20,0,8"/>

                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <Label Text="Summon Hotkey"
                           VerticalOptions="Center"/>

                    <HorizontalStackLayout Grid.Column="1" Spacing="8">
                        <Border Padding="8,4"
                                StrokeShape="RoundRectangle 4"
                                BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#374151}">
                            <Label Text="{Binding HotkeyDisplay}"
                                   FontFamily="Consolas"/>
                        </Border>

                        <Button Text="{Binding ChangeButtonText}"
                                AutomationId="ChangeHotkeyButton"
                                SemanticProperties.Description="Change hotkey"
                                Command="{Binding ChangeHotkeyCommand}"
                                Padding="8,4"
                                FontSize="12"/>
                    </HorizontalStackLayout>

                    <Label Grid.Row="1" Grid.ColumnSpan="2"
                           Text="{Binding HotkeyError}"
                           TextColor="#EF4444"
                           FontSize="12"
                           IsVisible="{Binding HotkeyError, Converter={StaticResource StringNotEmptyConverter}}"/>
                </Grid>

                <VerticalStackLayout Spacing="8" IsEnabled="{Binding IsCapturingHotkey, Converter={StaticResource InvertedBoolConverter}}">
                    <!-- ── Appearance ────────────────────────────────────── -->
                    <Label Text="Appearance"
                           FontSize="18"
                           FontAttributes="Bold"
                           Margin="0,20,0,8"/>

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto">
                        <Label Text="Theme"
                               VerticalOptions="Center"/>
                        <Picker Grid.Column="1"
                                AutomationId="ThemePicker"
                                SemanticProperties.Description="Theme"
                                ItemsSource="{Binding AvailableThemes}"
                                SelectedItem="{Binding SelectedThemeString}"/>
                    </Grid>

                    <Label Text="'System' follows your Windows theme setting"
                           FontSize="11"
                           TextColor="Gray"
                           Margin="0,4,0,0"/>

                    <!-- ── Startup ───────────────────────────────────────── -->
                    <Label Text="Startup"
                           FontSize="18"
                           FontAttributes="Bold"
                           Margin="0,20,0,8"/>

                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto">
                        <Label Text="Start with Windows"
                               VerticalOptions="Center"/>
                        <Switch Grid.Column="1"
                                AutomationId="StartWithWindowsSwitch"
                                SemanticProperties.Description="Start with Windows"
                                IsToggled="{Binding StartWithWindows}"/>
                    </Grid>
                    <Label Text="When enabled, BeNGy starts when Windows starts"
                           FontSize="11"
                           TextColor="Gray"
                           Margin="0,4,0,0"/>

                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto" Margin="0,12,0,0">
                        <Label Text="Start minimized to tray"
                               VerticalOptions="Center"/>
                        <Switch Grid.Column="1"
                                AutomationId="StartMinimizedSwitch"
                                SemanticProperties.Description="Start minimized to tray"
                                IsToggled="{Binding StartMinimized}"/>
                    </Grid>
                    <Label Text="When enabled, BeNGy starts in the system tray without showing a window"
                           FontSize="11"
                           TextColor="Gray"
                           Margin="0,4,0,0"/>

                    <!-- ── Behavior ──────────────────────────────────────── -->
                    <Label Text="Behavior"
                           FontSize="18"
                           FontAttributes="Bold"
                           Margin="0,20,0,8"/>

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                        <Label Text="Auto-close delay"
                               VerticalOptions="Center"/>

                        <Picker Grid.Column="1"
                                AutomationId="AutoCloseDelayPicker"
                                SemanticProperties.Description="Auto-close delay"
                                ItemsSource="{Binding DelayOptions}"
                                SelectedItem="{Binding SelectedDelayOption}"/>

                        <Label Grid.Row="1" Grid.ColumnSpan="2"
                               Text="{Binding AutoCloseDelayLabel}"
                               FontSize="11"
                               TextColor="Gray"
                               Margin="0,4,0,0"/>
                    </Grid>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
