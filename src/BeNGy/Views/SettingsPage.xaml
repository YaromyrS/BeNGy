<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BeNGy.ViewModels"
             x:Class="BeNGy.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="Settings"
             BackgroundColor="Transparent"
             NavigationPage.HasNavigationBar="False"
             NavigationPage.HasBackButton="False">

    <!-- HasBackButton="False" is NOT redundant with HasNavigationBar="False": the
         hidden bar still left MAUI's NavigationView back button enabled and
         keyboard-focusable (invisible, empty bounds). Opening Settings after
         keyboard input put focus on it, so a stray "Back" tooltip popped at the
         window corner and Tab had an invisible stop. The page has its own
         DoneButton for going back. -->
    <Grid>
        <!-- Capture overlay retained from the original page (M1 fix) -->
        <BoxView IsVisible="{Binding IsCapturingHotkey}"
            BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray900}}"
            Opacity="0.5"
            InputTransparent="False"
            ZIndex="10">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ChangeHotkeyCommand}" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <ScrollView Padding="20,14,20,20">
            <VerticalStackLayout Spacing="4">

                <!-- Header: back chevron (same handler as Done) + title + close.
                     Dragging is a native caption region declared by
                     WindowService (InputNonClientPointerSource) — no gestures. -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,0,0,8">
                    <Button
                        AutomationId="DoneButton"
                        Style="{StaticResource GlyphButton}"
                        Text="&#xE72B;"
                        Clicked="OnDoneClicked"
                        SemanticProperties.Description="Done" />
                    <Label Grid.Column="1" Text="Settings" FontSize="20" FontAttributes="Bold" VerticalOptions="Center" VerticalTextAlignment="Center" />
                    <Button Grid.Column="2"
                        AutomationId="SettingsCloseButton"
                        Style="{StaticResource CloseGlyphButton}"
                        Text="&#xE8BB;"
                        Clicked="OnCloseClicked"
                        SemanticProperties.Description="Close to tray" />
                </Grid>

                <VerticalStackLayout Spacing="4" IsEnabled="{Binding IsCapturingHotkey, Converter={StaticResource InvertedBoolConverter}}">
                    <Label Text="BRANCH GENERATION" Style="{StaticResource SectionHeader}" />
                    <Border Style="{StaticResource SettingsCard}">
                        <VerticalStackLayout>
                            <Grid ColumnDefinitions="Auto,*,180" ColumnSpacing="10" HeightRequest="52">
                                <Label Text="&#xE8AC;" FontFamily="Segoe Fluent Icons" VerticalOptions="Center" VerticalTextAlignment="Center" />
                                <Label Grid.Column="1" Text="Default prefix" VerticalOptions="Center" VerticalTextAlignment="Center" />
                                <Picker Grid.Column="2" AutomationId="DefaultPrefixPicker"
                                    SemanticProperties.Description="Default prefix"
                                    ItemsSource="{Binding AvailablePrefixes}" SelectedItem="{Binding DefaultPrefix}"
                                    VerticalOptions="Center" />
                            </Grid>
                            <BoxView Style="{StaticResource SettingsRowSeparator}" />
                            <!-- User-managed prefix catalog: expander row, collapsed by default -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" HeightRequest="52">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding TogglePrefixListCommand}" />
                                </Grid.GestureRecognizers>
                                <Label Text="&#xE8FD;" FontFamily="Segoe Fluent Icons" VerticalOptions="Center" VerticalTextAlignment="Center" />
                                <Label Grid.Column="1" Text="Prefixes" VerticalOptions="Center" VerticalTextAlignment="Center" />
                                <Label Grid.Column="2"
                                    AutomationId="PrefixExpanderChevron"
                                    Text="{Binding PrefixChevron}"
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="12"
                                    VerticalOptions="Center"
                                    Margin="0,0,4,0" />
                            </Grid>
                            <VerticalStackLayout IsVisible="{Binding IsPrefixListExpanded}">
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding AvailablePrefixes}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" HeightRequest="38">
                                                <Label Text="{Binding .}" Style="{StaticResource MonoText}" FontSize="13" VerticalOptions="Center" VerticalTextAlignment="Center" />
                                                <Button Grid.Column="1"
                                                    Style="{StaticResource DangerGlyphButton}"
                                                    Text="&#xE74D;"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, Path=RemovePrefixCommand}"
                                                    CommandParameter="{Binding .}"
                                                    SemanticProperties.Description="Delete prefix" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" HeightRequest="46" Margin="0,0,0,4">
                                    <Entry
                                        AutomationId="NewPrefixEntry"
                                        Placeholder="new-prefix"
                                        Text="{Binding NewPrefix}"
                                        ReturnCommand="{Binding AddPrefixCommand}"
                                        VerticalOptions="Center" />
                                    <Button Grid.Column="1"
                                        AutomationId="AddPrefixButton"
                                        Style="{StaticResource GlyphButton}"
                                        Text="&#xE710;"
                                        Command="{Binding AddPrefixCommand}"
                                        SemanticProperties.Description="Add prefix" />
                                </Grid>
                            </VerticalStackLayout>
                            <BoxView Style="{StaticResource SettingsRowSeparator}" />
                            <Grid ColumnDefinitions="Auto,*,180" ColumnSpacing="10" HeightRequest="52">
                                <Label Text="&#xE8D2;" FontFamily="Segoe Fluent Icons" VerticalOptions="Center" VerticalTextAlignment="Center" />
                                <Label Grid.Column="1" Text="Title format" VerticalOptions="Center" VerticalTextAlignment="Center" />
                                <Picker Grid.Column="2" AutomationId="TitleFormatPicker"
                                    SemanticProperties.Description="Title format"
                                    ItemsSource="{Binding AvailableTitleFormats}" SelectedItem="{Binding SelectedTitleFormat}"
                                    VerticalOptions="Center" />
                            </Grid>
                            <BoxView Style="{StaticResource SettingsRowSeparator}" />
                            <Grid ColumnDefinitions="Auto,*,180" ColumnSpacing="10" HeightRequest="52">
                                <Label Text="&#xE8A4;" FontFamily="Segoe Fluent Icons" VerticalOptions="Center" VerticalTextAlignment="Center" />
                                <Label Grid.Column="1" Text="Prefix / ticket separator" VerticalOptions="Center" VerticalTextAlignment="Center" />
                                <Picker Grid.Column="2" AutomationId="PrefixSeparatorPicker"
                                    SemanticProperties.Description="Prefix ticket separator"
                                    ItemsSource="{Binding AvailableSeparators}" SelectedItem="{Binding PrefixTicketSeparator}"
                                    VerticalOptions="Center" />
                            </Grid>
                            <BoxView Style="{StaticResource SettingsRowSeparator}" />
                            <Grid ColumnDefinitions="Auto,*,180" ColumnSpacing="10" HeightRequest="52">
                                <Label Text="&#xE8A4;" FontFamily="Segoe Fluent Icons" VerticalOptions="Center" VerticalTextAlignment="Center" />
                                <Label Grid.Column="1" Text="Ticket / title separator" VerticalOptions="Center" VerticalTextAlignment="Center" />
                                <Picker Grid.Column="2" AutomationId="TicketSeparatorPicker"
                                    SemanticProperties.Description="Ticket title separator"
                                    ItemsSource="{Binding AvailableSeparators}" SelectedItem="{Binding TicketTitleSeparator}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <Label Text="GLOBAL HOTKEY" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource SettingsCard}">
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" HeightRequest="52">
                            <Label Text="&#xE765;" FontFamily="Segoe Fluent Icons" VerticalOptions="Center" VerticalTextAlignment="Center" />
                            <Label Grid.Column="1" Text="Summon hotkey" VerticalOptions="Center" VerticalTextAlignment="Center" />
                            <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
                                <!-- One keycap per key, PowerToys-style: [Ctrl] [Shift] [B] -->
                                <HorizontalStackLayout
                                    Spacing="4"
                                    VerticalOptions="Center"
                                    BindableLayout.ItemsSource="{Binding HotkeyDisplay, Converter={StaticResource HotkeyPartsConverter}}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Border Style="{StaticResource KeycapChip}">
                                                <Label Text="{Binding .}" Style="{StaticResource MonoText}" FontSize="12" />
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </HorizontalStackLayout>
                                <Button Text="{Binding ChangeButtonText}"
                                    AutomationId="ChangeHotkeyButton"
                                    SemanticProperties.Description="Change hotkey"
                                    Command="{Binding ChangeHotkeyCommand}"
                                    FontSize="12" />
                            </HorizontalStackLayout>
                        </Grid>
                        <Label Text="{Binding HotkeyError}"
                            Style="{StaticResource Caption}"
                            TextColor="#EF4444"
                            IsVisible="{Binding HotkeyError, Converter={StaticResource StringNotEmptyConverter}}"
                            Margin="0,0,0,8" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="4" IsEnabled="{Binding IsCapturingHotkey, Converter={StaticResource InvertedBoolConverter}}">
                    <Label Text="APPEARANCE" Style="{StaticResource SectionHeader}" />
                    <Border Style="{StaticResource SettingsCard}">
                        <Grid ColumnDefinitions="Auto,*,180" ColumnSpacing="10" HeightRequest="52">
                            <Label Text="&#xE790;" FontFamily="Segoe Fluent Icons" VerticalOptions="Center" VerticalTextAlignment="Center" />
                            <Label Grid.Column="1" Text="Theme" VerticalOptions="Center" VerticalTextAlignment="Center" />
                            <Picker Grid.Column="2" AutomationId="ThemePicker"
                                SemanticProperties.Description="Theme"
                                ItemsSource="{Binding AvailableThemes}" SelectedItem="{Binding SelectedThemeString}"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Label Text="STARTUP" Style="{StaticResource SectionHeader}" />
                    <Border Style="{StaticResource SettingsCard}">
                        <VerticalStackLayout>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" HeightRequest="52">
                                <Label Text="&#xE7E8;" FontFamily="Segoe Fluent Icons" VerticalOptions="Center" VerticalTextAlignment="Center" />
                                <Label Grid.Column="1" Text="Start with Windows" VerticalOptions="Center" VerticalTextAlignment="Center" />
                                <Switch Grid.Column="2" AutomationId="StartWithWindowsSwitch"
                                    SemanticProperties.Description="Start with Windows"
                                    IsToggled="{Binding StartWithWindows}" VerticalOptions="Center" HorizontalOptions="End" />
                            </Grid>
                            <BoxView Style="{StaticResource SettingsRowSeparator}" />
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" HeightRequest="52">
                                <Label Text="&#xE8A0;" FontFamily="Segoe Fluent Icons" VerticalOptions="Center" VerticalTextAlignment="Center" />
                                <Label Grid.Column="1" Text="Start minimized to tray" VerticalOptions="Center" VerticalTextAlignment="Center" />
                                <Switch Grid.Column="2" AutomationId="StartMinimizedSwitch"
                                    SemanticProperties.Description="Start minimized to tray"
                                    IsToggled="{Binding StartMinimized}" VerticalOptions="Center" HorizontalOptions="End" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="BEHAVIOR" Style="{StaticResource SectionHeader}" />
                    <Border Style="{StaticResource SettingsCard}">
                        <Grid ColumnDefinitions="Auto,*,180" ColumnSpacing="10" HeightRequest="52">
                            <Label Text="&#xE916;" FontFamily="Segoe Fluent Icons" VerticalOptions="Center" VerticalTextAlignment="Center" />
                            <Label Grid.Column="1" Text="Auto-close delay" VerticalOptions="Center" VerticalTextAlignment="Center" />
                            <Picker Grid.Column="2" AutomationId="AutoCloseDelayPicker"
                                SemanticProperties.Description="Auto-close delay"
                                ItemsSource="{Binding DelayOptions}" SelectedItem="{Binding SelectedDelayOption}"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
