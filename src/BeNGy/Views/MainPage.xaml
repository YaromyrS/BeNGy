<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
			 xmlns:vm="clr-namespace:BeNGy.ViewModels"
			 xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
			 x:Class="BeNGy.Views.MainPage"
			 x:DataType="vm:MainViewModel"
			 Title="BeNGy"
			 BackgroundColor="Transparent"
			 NavigationPage.HasNavigationBar="False">

	<ScrollView>
		<VerticalStackLayout Spacing="12" Padding="20,14,20,14">

			<!-- Header. Dragging is handled natively by WindowService (pointer
			     messages on the WinUI bridge window) — no gestures here. -->
			<Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
				<Label Text="BeNGy" Style="{StaticResource PaletteTitle}" VerticalOptions="Center" />
				<Button Grid.Column="1"
					AutomationId="SettingsButton"
					Style="{StaticResource GlyphButton}"
					Text="&#xE713;"
					Clicked="OnSettingsClicked"
					SemanticProperties.Description="Settings" />
				<Button Grid.Column="2"
					AutomationId="CloseButton"
					Style="{StaticResource CloseGlyphButton}"
					Text="&#xE8BB;"
					Command="{Binding DismissCommand}"
					SemanticProperties.Description="Close to tray" />
			</Grid>

			<!-- Input row: prefix + ticket side by side -->
			<Grid ColumnDefinitions="150,*" ColumnSpacing="12">
				<Picker
					x:Name="PrefixPicker"
					AutomationId="PrefixPicker"
					SemanticProperties.Description="Branch prefix"
					ItemsSource="{Binding PrefixOptions}"
					SelectedItem="{Binding Prefix}" />
				<Entry Grid.Column="1"
					x:Name="TicketEntry"
					AutomationId="TicketEntry"
					SemanticProperties.Description="Ticket number"
					Text="{Binding TicketNumber}"
					Placeholder="EXP-123"
					Keyboard="Plain"
					ReturnType="Next" />
			</Grid>

			<Entry
				x:Name="TitleEntry"
				AutomationId="TitleEntry"
				SemanticProperties.Description="Branch title"
				Text="{Binding Title}"
				Placeholder="Ticket Title"
				Keyboard="Plain"
				ReturnType="Done"
				ReturnCommand="{Binding CopyCommand}" />

			<!-- Preview card: branch name | copy icon. The whole card copies. -->
			<Border Style="{StaticResource PreviewCard}" Padding="12,4" HeightRequest="44">
				<Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
					<Label
						x:Name="PreviewLabel"
						AutomationId="PreviewLabel"
						SemanticProperties.Description="Generated branch name preview"
						Style="{StaticResource MonoText}"
						Text="{Binding GeneratedBranchName}"
						TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
						LineBreakMode="TailTruncation"
						VerticalOptions="Center">
						<Label.GestureRecognizers>
							<TapGestureRecognizer Command="{Binding CopyCommand}" />
						</Label.GestureRecognizers>
					</Label>
					<BoxView Grid.Column="1"
						WidthRequest="1"
						HeightRequest="22"
						VerticalOptions="Center"
						Color="{AppThemeBinding Light={StaticResource CardStroke}, Dark={StaticResource CardStrokeDark}}" />
					<Button Grid.Column="2"
						x:Name="CopyButton"
						AutomationId="CopyButton"
						SemanticProperties.Description="Copy branch name to clipboard"
						Style="{StaticResource CardGlyphButton}"
						WidthRequest="32"
						HeightRequest="32"
						FontSize="14"
						Text="&#xE8C8;"
						Command="{Binding CopyCommand}"
						VerticalOptions="Center">
						<Button.Triggers>
							<!-- Brief checkmark feedback after a successful copy -->
							<DataTrigger TargetType="Button" Binding="{Binding CopySuccess}" Value="True">
								<Setter Property="Text" Value="&#xE73E;" />
								<Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SuccessText}, Dark={StaticResource SuccessTextDark}}" />
							</DataTrigger>
						</Button.Triggers>
					</Button>
				</Grid>
			</Border>

			<!-- One amber InfoBar replaces the loose warning labels; every
			     AutomationId inside survives for the E2E assertions. -->
			<Border
				Style="{StaticResource WarningInfoBar}"
				IsVisible="{Binding IsValid, Converter={toolkit:InvertedBoolConverter}}">
				<!-- Neither Border nor panels get WinUI automation peers, so this
				     container is NOT findable by UIA id — tests must anchor on the
				     Labels inside (e.g. ValidationMessageLabel). The id stays for
				     tree-walking tools that use the raw view. -->
				<Grid AutomationId="ValidationWarningSection" ColumnDefinitions="Auto,*" ColumnSpacing="10">
					<Label Text="&#xE7BA;"
						FontFamily="Segoe Fluent Icons"
						FontSize="16"
						TextColor="{AppThemeBinding Light={StaticResource WarningText}, Dark={StaticResource WarningTextDark}}"
						VerticalOptions="Start" />
					<VerticalStackLayout Grid.Column="1" Spacing="2">
						<Label
							AutomationId="ValidationMessageLabel"
							Style="{StaticResource Caption}"
							TextColor="{AppThemeBinding Light={StaticResource WarningText}, Dark={StaticResource WarningTextDark}}"
							Text="{Binding ValidationMessage}"
							IsVisible="{Binding ValidationMessage, Converter={StaticResource StringNotEmptyConverter}}"
							LineBreakMode="WordWrap" />
						<HorizontalStackLayout AutomationId="InvalidCharsRow" IsVisible="{Binding HasInvalidCharacters}" Spacing="4">
							<Label
								AutomationId="InvalidCharsPrefix"
								Style="{StaticResource Caption}"
								TextColor="{AppThemeBinding Light={StaticResource WarningText}, Dark={StaticResource WarningTextDark}}"
								Text="Characters not allowed:"
								VerticalOptions="Center" />
							<Label
								AutomationId="InvalidCharsLabel"
								Style="{StaticResource MonoText}"
								FontSize="12"
								FontAttributes="Bold"
								TextColor="{AppThemeBinding Light={StaticResource WarningText}, Dark={StaticResource WarningTextDark}}"
								Text="{Binding InvalidCharactersDisplay}"
								VerticalOptions="Center" />
						</HorizontalStackLayout>
					</VerticalStackLayout>
				</Grid>
			</Border>

		</VerticalStackLayout>
	</ScrollView>

</ContentPage>
