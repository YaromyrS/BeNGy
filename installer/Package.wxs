<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <!-- Per-user install (no admin prompt) to %LocalAppData%\Programs\BeNGy.
       UpgradeCode is permanent: never change it, or upgrades stop replacing
       older versions. -->
  <Package Name="BeNGy"
           Manufacturer="BeNGy"
           Version="$(var.Version)"
           UpgradeCode="07C1475F-9FDC-4A77-9BFD-F3EBDF78F03F"
           Scope="perUser"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of BeNGy is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="BeNGyIcon" SourceFile="$(var.PublishDir)BeNGy.exe" />
    <Property Id="ARPPRODUCTICON" Value="BeNGyIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/YaromyrS/BeNGy/issues" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/YaromyrS/BeNGy" />

    <!-- Explicitly under the profile. A per-user MSI does NOT redirect
         ProgramFiles*Folder: the first build installed to C:\Program Files,
         which only worked because the test user was an administrator
         (tools/packaging/test-installers-sandbox.ps1 caught it). -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="BeNGy" />
      </Directory>
    </StandardDirectory>

    <!-- Windows Installer leaves profile folders it created behind (the empty
         BeNGy\ tree). RemoveFolderEx deletes the whole folder on uninstall; it
         runs before directories resolve, so the path is remembered in HKCU
         and read back by the RegistrySearch. -->
    <Property Id="INSTALLFOLDER_REMEMBERED">
      <RegistrySearch Id="RememberedInstallFolder" Root="HKCU" Key="Software\BeNGy\Installer"
                      Name="InstallFolder" Type="raw" />
    </Property>
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="InstallFolderCleanup" Guid="7C3D00CE-22E9-42AD-9E52-20C707ACB990">
        <RegistryValue Root="HKCU" Key="Software\BeNGy\Installer" Name="InstallFolder"
                       Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        <util:RemoveFolderEx On="uninstall" Property="INSTALLFOLDER_REMEMBERED" />
      </Component>
    </DirectoryRef>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="B1E8611D-F6AF-47D8-997F-1426E077B372">
        <Shortcut Id="BeNGyShortcut"
                  Name="BeNGy"
                  Description="Git branch name generator"
                  Target="[INSTALLFOLDER]BeNGy.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\BeNGy\Installer" Name="StartMenuShortcut"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="BeNGy">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="InstallFolderCleanup" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)**" />
    </ComponentGroup>
  </Fragment>
</Wix>
