<Project Sdk="WixToolset.Sdk/5.0.2">
  <!-- Setup.exe (WiX Burn bundle) that installs the MSI. Built by
       tools/packaging/build-release.ps1 after the MSI, which passes MsiPath,
       IconFile (the .ico MAUI generates from appicon.svg) and Version. -->
  <PropertyGroup>
    <OutputName>BeNGy-Setup-x64</OutputName>
    <OutputType>Bundle</OutputType>
    <Platform>x64</Platform>
    <Version Condition="'$(Version)' == ''">0.0.0</Version>
    <DefineConstants>MsiPath=$(MsiPath);IconFile=$(IconFile);Version=$(Version)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Bal.wixext" Version="5.0.2" />
    <Compile Include="Bundle.wxs" />
  </ItemGroup>
  <PropertyGroup>
    <!-- Both installer projects share this folder: no default *.wxs globbing. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
</Project>
